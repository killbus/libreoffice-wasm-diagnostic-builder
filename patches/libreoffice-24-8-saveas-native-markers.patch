new file mode 100644
index 000000000000..24cd0e88cc68
--- /dev/null
+++ b/include/vcl/lokwasmsaveasdiagnostic.hxx
@@ -0,0 +1,58 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Diagnostic-only instrumentation for the browser-WASM save/export pipeline.
+ * Do not include document content, URLs, filenames, filter options, or UNO data.
+ */
+
+#ifndef INCLUDED_VCL_LOKWASMSAVEASDIAGNOSTIC_HXX
+#define INCLUDED_VCL_LOKWASMSAVEASDIAGNOSTIC_HXX
+
+#include <chrono>
+#include <cstdio>
+
+namespace vcl::lok
+{
+class WasmSaveAsDiagnosticScope final
+{
+public:
+    WasmSaveAsDiagnosticScope(const char* pBoundary, const void* pObject,
+                              long long nPage = -1) noexcept
+        : mpBoundary(pBoundary)
+        , mpObject(pObject)
+        , mnPage(nPage)
+    {
+        emit("entry");
+    }
+
+    ~WasmSaveAsDiagnosticScope() noexcept { emit("exit"); }
+
+    WasmSaveAsDiagnosticScope(const WasmSaveAsDiagnosticScope&) = delete;
+    WasmSaveAsDiagnosticScope& operator=(const WasmSaveAsDiagnosticScope&) = delete;
+
+private:
+    void emit(const char* pEvent) const noexcept
+    {
+#if defined(__EMSCRIPTEN__)
+        using Clock = std::chrono::steady_clock;
+        const auto nSteadyUs = std::chrono::duration_cast<std::chrono::microseconds>(
+                                   Clock::now().time_since_epoch())
+                                   .count();
+        std::fprintf(stderr,
+                     "[LOK_SAVEAS_TRACE] steady_us=%lld boundary=%s event=%s object=%p page=%lld\n",
+                     static_cast<long long>(nSteadyUs), mpBoundary, pEvent,
+                     const_cast<void*>(mpObject), mnPage);
+        std::fflush(stderr);
+#else
+        (void)pEvent;
+#endif
+    }
+
+    const char* mpBoundary;
+    const void* mpObject;
+    long long mnPage;
+};
+}
+
+#endif
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
